{
  "name": "Schema.org",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r software/requirements.txt",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Schema.org local site",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
