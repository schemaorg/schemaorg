    }
  ]
}
</script>


TURTLE (RDF):

turtle
@prefix schema: <https://schema.org/> .
@prefix ex: <https://example.com/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:fictionalteam
    a schema:Organization ;
    schema:name "Fictional Team" ;
    schema:alternateName "fictionalteam" ;
    schema:logo <https://exemplo.com.br/logo.png> ;
    schema:location [
        a schema:Place ;
        schema:name "Location Name"
    ] ;
    schema:member
        [
            a schema:Person ;
            schema:name "Member One"
        ],
        [
            a schema:Person ;
            schema:name "Member Two"
        ],
        [
            a schema:Person ;
            schema:name "Member Three"
        ] .