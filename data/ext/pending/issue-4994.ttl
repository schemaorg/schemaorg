@prefix schema: <https://schema.org/> .
@prefix ex: <https://example.com/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:i-love-bees
    a schema:Game ;
    schema:name "I Love Bees" ;
    schema:description "A scary Alternate Reality Game (ARG). Boo!" ;
    schema:sameAs <https://en.wikipedia.org/wiki/I_Love_Bees> ;
    schema:author [
        a schema:Person ;
        schema:name "Author name"
    ] ;
    schema:award "Award name" ;
    schema:gameLocation [
        a schema:Place ;
        schema:name "United States"
    ] ;
    schema:datePublished "2004-08-11"^^xsd:date ;
    schema:discussionUrl <https://example.com/discussion> ;
    schema:alternativeHeadline "A Title" ;
    schema:image <https://example.com/image.jpg> ;
    schema:isBasedOn [
        a schema:CreativeWork ;
        schema:name "Original source work"
    ] ;
    schema:url <https://example.com> ;
    schema:publisher [
        a schema:Organization ;
        schema:name "Publisher name"
    ] .
