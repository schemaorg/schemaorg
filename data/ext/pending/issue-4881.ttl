TURTLE (RDF):

turtle
@prefix schema: <https://schema.org/> .
@prefix ex: <https://example.com/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.com/tv-pilot>
    a schema:TVEpisode ;
    schema:name "TV Pilot Name" ;
    schema:alternateName "Other name" ;
    schema:description "A nice pilot." ;

    schema:image
        <https://example.com/image-1.jpg>,
        <https://example.com/image-2.jpg> ;

    schema:datePublished "2026-08-30"^^xsd:date ;
    schema:genre "Documentary" ;

    schema:productionCompany [
        a schema:Organization ;
        schema:name "ComfortSeat"
    ] ;

    schema:countryOfOrigin [
        a schema:Country ;
        schema:name "Brazil"
    ] ;

    schema:partOfSeries [
        a schema:TVSeries ;
        schema:name "Thing"
    ] ;

    schema:trailer [
        a schema:VideoObject ;
        schema:duration "PT1M33S" ;
        schema:name "Trailer" ;
        schema:contentUrl <https://example.com>
    ] .
