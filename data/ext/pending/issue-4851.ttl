@prefix : <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:sourceFile a rdf:Property ;
    rdfs:label "sourceFile" ;
    :domainIncludes :CreativeWork ;
    :isPartOf <https://pending.schema.org> ;
    :rangeIncludes :URL, :MediaObject ;
    :source <https://github.com/schemaorg/schemaorg/issues/4851> ;
    rdfs:comment "Location of the source file(s) from which this work is produced (e.g., file URL, repository, archive)." ;
    rdfs:seeAlso <https://doi.org/10.5281/zenodo.20237079> .
