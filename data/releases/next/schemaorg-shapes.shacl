:ValidSchema3DModel a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:or ( [ sh:node :ValidSchemaBoolean ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:isResizable ] ;
    sh:targetClass schema:3DModel .

