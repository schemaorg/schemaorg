:ValidSchemaAccommodation a sh:NodeShape ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ sh:node :ValidSchemaText ;
            sh:path schema:accommodationCategory ],
        [ sh:or ( [ sh:node :ValidSchemaFloorPlan ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:accommodationFloorPlan ],
        [ sh:or ( [ sh:node :ValidSchemaLocationFeatureSpecification ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:amenityFeature ],
        [ sh:or ( [ sh:node :ValidSchemaBedDetails ] [ sh:node :ValidSchemaBedType ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:bed ],
        [ sh:node :ValidSchemaText ;
            sh:path schema:floorLevel ],
        [ sh:or ( [ sh:node :ValidSchemaQuantitativeValue ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:floorSize ],
        [ sh:or ( [ sh:node :ValidSchemaDuration ] [ sh:node :ValidSchemaQuantitativeValue ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:leaseLength ],
        [ sh:or ( [ sh:node :ValidSchemaInteger ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:numberOfBathroomsTotal ],
        [ sh:or ( [ sh:node :ValidSchemaNumber ] [ sh:node :ValidSchemaQuantitativeValue ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:numberOfBedrooms ],
        [ sh:or ( [ sh:node :ValidSchemaNumber ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:numberOfFullBathrooms ],
        [ sh:or ( [ sh:node :ValidSchemaNumber ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:numberOfPartialBathrooms ],
        [ sh:or ( [ sh:node :ValidSchemaNumber ] [ sh:node :ValidSchemaQuantitativeValue ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:numberOfRooms ],
        [ sh:or ( [ sh:node :ValidSchemaQuantitativeValue ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:occupancy ],
        [ sh:node :ValidSchemaText ;
            sh:path schema:permittedUsage ],
        [ sh:or ( [ sh:node :ValidSchemaBoolean ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:petsAllowed ],
        [ sh:or ( [ sh:node :ValidSchemaText ] [ sh:node :ValidSchemaURL ] ) ;
            sh:path schema:tourBookingPage ],
        [ sh:or ( [ sh:node :ValidSchemaNumber ] [ sh:node :ValidSchemaText ] ) ;
            sh:path schema:yearBuilt ] ;
    sh:targetClass schema:Accommodation .

